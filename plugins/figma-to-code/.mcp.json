{
  "mcpServers": {
    "figma-view": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp@0.13.2", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--isolated", "--device", "Desktop Chrome HiDPI", "--output-dir", "${CLAUDE_PLUGIN_DATA}/playwright"]
    }
  }
}
